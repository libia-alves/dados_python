    <attributes/>
  </transform>
  <transform>
    <type>UserDefinedJavaClass</type>
    <name>validar e registrar erros</name>
    <fields/>
    <definitions>
      <definition>
        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source>
private int idxStation;
private int idxTimestamp;
private int idxSource;

public boolean processRow() throws HopException {
  Object[] r = getRow();
  if (r == null) {
    setOutputDone();
    return false;
  }

  if (first) {
    first = false;
    idxStation = getInputRowMeta().indexOfValue("STATION");
    idxTimestamp = getInputRowMeta().indexOfValue("TIMESTAMP");
    idxSource = getInputRowMeta().indexOfValue("SOURCE");
  }

  String estacao = getInputRowMeta().getString(r, idxStation);
  java.util.Date dataHora = getInputRowMeta().getDate(r, idxTimestamp);
  String origem = getInputRowMeta().getString(r, idxSource);

  if (estacao == null || estacao.trim().length() == 0 || dataHora == null) {
    logError("invalid_input_row origem=" + origem
        + " estacao=" + estacao
        + " timestamp=" + dataHora
        + " motivo=estacao_ou_timestamp_ausente");
    return true;
  }

  putRow(getInputRowMeta(), r);
  return true;
}
</class_source>
      </definition>
    </definitions>
    <clear_result_fields>N</clear_result_fields>
    <info_transforms/>
    <target_transforms/>
    <usage_parameters/>
    <java_target_version>6</java_target_version>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>432</xloc>
      <yloc>208</yloc>
    </GUI>
    <description>Descarta e registra no log da pipeline (nivel ERROR) qualquer linha sem estacao ou sem timestamp valido. Recebe as duas fontes juntas (2 hops de entrada = uniao das duas correntes).</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
