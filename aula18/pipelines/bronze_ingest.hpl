    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>marcar origem fonte 2</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>fonte_2_weather.csv</nullif>
        <name>SOURCE</name>
