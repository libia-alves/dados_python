  <transform>
    <type>Constant</type>
    <name>marcar origem fonte 1</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>fonte_1_estacao.csv</nullif>
        <name>SOURCE</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>240</xloc>
      <yloc>128</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
