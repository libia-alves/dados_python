<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>silver_quarantine_split</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Le a camada bronze, aplica as duas regras de qualidade (mais de 30% dos campos meteorologicos faltando; temperatura igual por mais de 4 horas seguidas na mesma estacao) e separa cada registro em silver (aprovado) ou quarentena (rejeitado, com o motivo).</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>BRONZE_DIR</name>
        <default_value>${PROJECT_HOME}/repository/bronze</default_value>
        <description>Pasta de entrada (camada bronze)</description>
      </parameter>
      <parameter>
        <name>SILVER_DIR</name>
        <default_value>${PROJECT_HOME}/repository/silver</default_value>
        <description>Pasta de saida da camada silver (registros aprovados)</description>
      </parameter>
      <parameter>
        <name>QUARANTINE_DIR</name>
        <default_value>${PROJECT_HOME}/repository/quarantine</default_value>
        <description>Pasta de saida da quarentena (registros rejeitados + motivo)</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/18 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/18 00:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>120</height>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <note>"avaliar qualidade" precisa dos dados ja ordenados por estacao e hora (passo anterior) para
detectar sequencias de temperatura constante. Ele calcula MISSING_PCT e CONSTANT_TEMP_4H e monta
MOTIVO_QUARENTENA (vazio = aprovado). Os dois passos seguintes sao filtros: um deixa passar so quem
NAO tem motivo (silver), o outro so quem TEM motivo (quarentena) e tambem grava no log (nivel WARN)
cada linha quarentenada - esse e o "registro de erros e problemas" pedido na atividade.</note>
      <width>820</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>ler bronze</from>
      <to>ordenar por estacao e hora</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>ordenar por estacao e hora</from>
      <to>avaliar qualidade</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>avaliar qualidade</from>
      <to>filtrar silver</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>avaliar qualidade</from>
      <to>filtrar quarentena</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>filtrar silver</from>
      <to>colunas silver</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>colunas silver</from>
      <to>gravar silver</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>filtrar quarentena</from>
      <to>gravar quarentena</to>
      <enabled>Y</enabled>
    </hop>
  </order>
