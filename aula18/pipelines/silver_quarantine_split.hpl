  <transform>
    <name>avaliar qualidade</name>
    <type>UserDefinedJavaClass</type>
    <description>Calcula MISSING_PCT (percentual de temperatura/umidade/vento faltando) e CONSTANT_TEMP_4H (Y/N: mesma temperatura por 5+ leituras horarias seguidas = mais de 4h) e monta MOTIVO_QUARENTENA. Requer entrada ja ordenada por STATION, TIMESTAMP.</description>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>MISSING_PCT</field_name>
        <field_type>Number</field_type>
        <field_length>-1</field_length>
        <field_precision>2</field_precision>
      </field>
      <field>
        <field_name>CONSTANT_TEMP_4H</field_name>
        <field_type>String</field_type>
        <field_length>-1</field_length>
        <field_precision>-1</field_precision>
      </field>
      <field>
        <field_name>MOTIVO_QUARENTENA</field_name>
        <field_type>String</field_type>
        <field_length>-1</field_length>
        <field_precision>-1</field_precision>
      </field>
    </fields>
    <definitions>
      <definition>
        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source><![CDATA[
import java.util.ArrayList;
import java.util.List;

private List<Object[]> runBuffer = new ArrayList<Object[]>();
private List<Double> runMissingPct = new ArrayList<Double>();
private String runStation = null;
private Double runTemp = null;
private java.util.Date runLastTimestamp = null;

private int idxStation;
private int idxTimestamp;
private int idxTemp;
private int idxHumidity;
private int idxWind;
private int outBase;

public boolean processRow() throws HopException {
  Object[] r = getRow();
  if (r == null) {
    flushRun();
    setOutputDone();
    return false;
  }

  if (first) {
    first = false;
    idxStation = getInputRowMeta().indexOfValue("STATION");
    idxTimestamp = getInputRowMeta().indexOfValue("TIMESTAMP");
    idxTemp = getInputRowMeta().indexOfValue("TEMPERATURE_C");
    idxHumidity = getInputRowMeta().indexOfValue("HUMIDITY_PCT");
    idxWind = getInputRowMeta().indexOfValue("WIND_KMH");
    outBase = getInputRowMeta().size();
  }

  String station = getInputRowMeta().getString(r, idxStation);
  java.util.Date timestamp = getInputRowMeta().getDate(r, idxTimestamp);
  Double temperature = getInputRowMeta().getNumber(r, idxTemp);
  Double humidity = getInputRowMeta().getNumber(r, idxHumidity);
  Double wind = getInputRowMeta().getNumber(r, idxWind);

  int missingCount = 0;
  if (temperature == null) missingCount++;
  if (humidity == null) missingCount++;
  if (wind == null) missingCount++;
  double missingPct = (missingCount / 3.0) * 100.0;

  Object[] outputRow = createOutputRow(r, data.outputRowMeta.size());
  outputRow[outBase] = new Double(missingPct);

  boolean continuesRun = runStation != null
      && runStation.equals(station)
      && temperature != null
      && runTemp != null
      && runTemp.doubleValue() == temperature.doubleValue()
      && runLastTimestamp != null
      && timestamp != null
      && (timestamp.getTime() - runLastTimestamp.getTime()) == 3600000L;

  if (continuesRun) {
    runBuffer.add(outputRow);
    runMissingPct.add(new Double(missingPct));
    runLastTimestamp = timestamp;
  } else {
    flushRun();
    if (temperature != null && timestamp != null) {
      runBuffer.add(outputRow);
      runMissingPct.add(new Double(missingPct));
      runStation = station;
      runTemp = temperature;
      runLastTimestamp = timestamp;
    } else {
      runStation = null;
      runTemp = null;
      runLastTimestamp = null;
      finishRow(outputRow, missingPct, false);
    }
  }
  return true;
}

private void flushRun() throws HopException {
  if (runBuffer.isEmpty()) {
    return;
  }
  boolean flagged = runBuffer.size() > 4;
  for (int i = 0; i < runBuffer.size(); i++) {
    finishRow((Object[]) runBuffer.get(i), ((Double) runMissingPct.get(i)).doubleValue(), flagged);
  }
  runBuffer.clear();
  runMissingPct.clear();
  runStation = null;
  runTemp = null;
  runLastTimestamp = null;
}

private void finishRow(Object[] outputRow, double missingPct, boolean constantTemp) throws HopException {
  outputRow[outBase + 1] = constantTemp ? "Y" : "N";
  StringBuilder motivo = new StringBuilder();
  if (missingPct > 30.0) {
    motivo.append("missing_above_30_percent");
  }
  if (constantTemp) {
    if (motivo.length() > 0) {
      motivo.append(";");
    }
    motivo.append("constant_temperature_over_4_hours");
  }
  outputRow[outBase + 2] = motivo.toString();
  putRow(data.outputRowMeta, outputRow);
}
]]></class_source>
      </definition>
