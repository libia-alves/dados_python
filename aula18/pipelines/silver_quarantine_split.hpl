  <transform>
    <name>filtrar quarentena</name>
    <type>UserDefinedJavaClass</type>
    <description>So deixa passar linhas com motivo de quarentena preenchido, e registra cada uma no log da pipeline (nivel WARN)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
