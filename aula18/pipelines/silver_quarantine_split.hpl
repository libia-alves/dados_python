    <definitions>
      <definition>
        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source><![CDATA[
private int idxMotivo;
private int idxStation;
private int idxTimestamp;

public boolean processRow() throws HopException {
  Object[] r = getRow();
  if (r == null) {
    setOutputDone();
    return false;
  }
  if (first) {
    first = false;
    idxMotivo = getInputRowMeta().indexOfValue("MOTIVO_QUARENTENA");
    idxStation = getInputRowMeta().indexOfValue("STATION");
    idxTimestamp = getInputRowMeta().indexOfValue("TIMESTAMP");
  }
  String motivo = getInputRowMeta().getString(r, idxMotivo);
  boolean quarentena = motivo != null && motivo.length() > 0;
  if (quarentena) {
    String estacao = getInputRowMeta().getString(r, idxStation);
    java.util.Date timestamp = getInputRowMeta().getDate(r, idxTimestamp);
    logBasic("record_quarantined estacao=" + estacao + " timestamp=" + timestamp + " motivo=" + motivo);
    putRow(getInputRowMeta(), r);
  }
  return true;
}
]]></class_source>
